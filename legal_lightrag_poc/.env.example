# Client and host settings
LIGHTRAG_URL=http://127.0.0.1:9621
PORT=9621
LIGHTRAG_REQUEST_TIMEOUT=60
LIGHTRAG_QUERY_TIMEOUT=300

# Replace this with a private random value before starting the server.
# Both the server and the Python scripts read this setting. IMPORTANT: an API
# key alone does not secure LightRAG's bundled Guest WebUI. This POC therefore
# binds only to 127.0.0.1. Do not expose or tunnel it without also configuring
# AUTH_ACCOUNTS and TOKEN_SECRET as described in the README.
LIGHTRAG_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
WHITELIST_PATHS=/health

# Required together with LIGHTRAG_API_KEY before any network exposure:
# AUTH_ACCOUNTS='admin:{bcrypt}$2b$PASTE_HASH_FROM_LIGHTRAG_HASH_PASSWORD'
# TOKEN_SECRET=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_VALUE
# TOKEN_EXPIRE_HOURS=4

# Fast POC model configuration. Replace both provider key values.
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=CHANGE_ME_PROVIDER_API_KEY
LLM_MODEL=gpt-5.4-mini
MAX_ASYNC_LLM=4
LLM_TIMEOUT=300

EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=CHANGE_ME_PROVIDER_API_KEY
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false
EMBEDDING_USE_BASE64=true

# POC indexing and retrieval settings
WORKSPACE=legal_poc
SUMMARY_LANGUAGE=English
ENTITY_EXTRACTION_USE_JSON=true
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
MAX_PARALLEL_INSERT=2
LIGHTRAG_PARSER=*:native-teP,*:legacy-R
RERANK_BINDING=null
RERANK_BY_DEFAULT=false

# Lightweight local persistence recommended for test deployments
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
